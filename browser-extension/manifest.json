{
  "manifest_version": 3,
  "name": "Startpage Media Controls",
  "version": "1.2.0",
  "description": "Connects startpage media controls, website appearance, and per-site element hiding.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pick an element to hide",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://person87-93.github.io/*", "http://localhost:8000/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["site-customizer.js"],
      "run_at": "document_start"
    }
  ]
}
