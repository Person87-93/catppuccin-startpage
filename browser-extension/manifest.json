{
  "manifest_version": 3,
  "name": "Catppuccin Startpage Tools",
  "version": "1.6.0",
  "description": "Connects the Catppuccin startpage with browser workspaces, focus mode, diagnostics, and website customisation.",
  "permissions": [
    "scripting",
    "storage",
    "contextMenus",
    "tabGroups",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pick an element to hide",
    "default_popup": "popup.html"
  },
  "commands": {
    "restore-hidden-elements": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Restore hidden elements on the current site"
    },
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the browser-wide command palette"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://person87-93.github.io/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site-customizer.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "focus-blocker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "notifications"
  ]
}
